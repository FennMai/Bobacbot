<mujoco model="bobacbot">
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>
  <option cone="elliptic" impratio="10"/>

  <default>
    <!-- Bobac3机器人底座相关默认设置 -->
    <default class="base">
      <default class="base/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="base/collision">
        <geom type="mesh" group="3"/>
      </default>
    </default>

    <!-- GEN72机械臂相关默认设置 -->
    <default class="gen72">
      <default class="gen72/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.75294 0.75294 0.75294 1"/>
      </default>
      <default class="gen72/collision">
        <geom type="mesh" group="3"/>
      </default>
      <default class="large_actuator">
        <position kp="2000" kv="100" forcerange="-105 105"/>
      </default>
      <default class="small_actuator">
        <position kp="500" kv="50" forcerange="-52 52"/>
      </default>
    </default>

    <!-- Robotiq 2F85 Gripper Defaults from tidybot.xml -->
    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>

      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001"
          solreflimit="0.005 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>

      <default class="2f85/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="2f85/collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="0.7"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="0.6"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>

    <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
  </default>

  <asset>
    <!-- Bobac3底座资源 -->
    <material name="black" rgba="0.11372549 0.11372549 0.10196078 1"/>
    <material name="gray" rgba="0.62745098 0.65098039 0.64705882 1"/>
    <material name="dark_gray" rgba="0.35294118 0.37647059 0.37254902 1"/>
    <material name="blue" rgba="0 0 0.7 1"/>
    <material name="white" rgba="1 1 1 1"/>
    
    <mesh file="bobac3/meshes/base_link.stl"/>
    <mesh file="bobac3/meshes/cover_link.stl"/>
    <mesh file="bobac3/meshes/smoke_link.stl"/>
    <mesh file="bobac3/meshes/humtmper_link.stl"/>
    <mesh file="bobac3/meshes/left_ultrasound_link.stl"/>
    <mesh file="bobac3/meshes/right_ultrasound_link.stl"/>
    <mesh file="bobac3/meshes/bottom_camera_link.stl"/>
    <mesh file="bobac3/meshes/base_berxel_camera_link.stl"/>
    <mesh file="bobac3/meshes/front_lidar_link.stl"/>
    <mesh file="bobac3/meshes/rear_lidar_link.stl"/>

    <!-- GEN72机械臂资源 -->
    <mesh name="gen72/base_link" file="gen72/meshes/base_link.stl"/>
    <mesh name="gen72/Link1" file="gen72/meshes/Link1.stl"/>
    <mesh name="gen72/Link2" file="gen72/meshes/Link2.stl"/>
    <mesh name="gen72/Link3" file="gen72/meshes/Link3.stl"/>
    <mesh name="gen72/Link4" file="gen72/meshes/Link4.stl"/>
    <mesh name="gen72/Link5" file="gen72/meshes/Link5.stl"/>
    <mesh name="gen72/Link6" file="gen72/meshes/Link6.stl"/>
    <mesh name="gen72/Link7" file="gen72/meshes/Link7.stl"/>

    <!-- Robotiq 2F85 Gripper Assets -->
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="2f85/gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="2f85/black" rgba="0.149 0.149 0.149 1"/>

    <mesh name="base" class="2f85" file="2f85/meshes/base.stl"/>
    <mesh name="driver" class="2f85" file="2f85/meshes/driver.stl"/>
    <mesh name="coupler" class="2f85" file="2f85/meshes/coupler.stl"/>
    <mesh name="follower" class="2f85" file="2f85/meshes/follower.stl"/>
    <mesh name="pad" class="2f85" file="2f85/meshes/pad.stl"/>
    <mesh name="silicone_pad" class="2f85" file="2f85/meshes/silicone_pad.stl"/>
    <mesh name="spring_link" class="2f85" file="2f85/meshes/spring_link.stl"/>
  </asset>

  <worldbody>
    <body name="base_link">
      <!-- 设置总质量和惯性矩 -->
      <inertial pos="0 0 0.035" mass="60" diaginertia="1.0 1.0 1.0"/>
      
      <!-- 添加x、y、yaw三个自由度 -->
      <joint name="joint_x" type="slide" axis="1 0 0"/>
      <joint name="joint_y" type="slide" axis="0 1 0"/>
      <joint name="joint_th" type="hinge" axis="0 0 1"/>
      
      <!-- 底座主体及其视觉和碰撞几何形状 -->
      <geom class="base/visual" mesh="base_link" material="white"/>
      <geom class="base/collision" mesh="base_link"/>
      
      <!-- 底座前方相机 -->
      <body name="base_depth_link" pos="0.176804 0 0.149">
