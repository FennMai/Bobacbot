    <exclude body1="base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
  </equality>

  <actuator>
    <!-- 底座执行器 -->
    <position name="joint_x" joint="joint_x" kp="1000000" kv="50000"/>
    <position name="joint_y" joint="joint_y" kp="1000000" kv="50000"/>
    <position name="joint_th" joint="joint_th" kp="50000" kv="1000"/>
    
    <!-- GEN72机械臂执行器 -->
    <position class="large_actuator" name="joint_1" joint="joint_1" ctrlrange="-3.0014 3.0014"/>
    <position class="large_actuator" name="joint_2" joint="joint_2" ctrlrange="-1.8323 1.8323"/>
    <position class="large_actuator" name="joint_3" joint="joint_3" ctrlrange="-3.0014 3.0014"/>
    <position class="large_actuator" name="joint_4" joint="joint_4" ctrlrange="-2.8792 0.9597"/>
    <position class="small_actuator" name="joint_5" joint="joint_5" ctrlrange="-3.0014 3.0014"/>
    <position class="small_actuator" name="joint_6" joint="joint_6" ctrlrange="-1.707 1.783"/>
    <position class="small_actuator" name="joint_7" joint="joint_7" ctrlrange="-3.0014 3.0014"/>

    <!-- Gripper Actuator -->
    <general class="2f85" name="fingers_actuator" tendon="split" forcerange="-5 5" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>

